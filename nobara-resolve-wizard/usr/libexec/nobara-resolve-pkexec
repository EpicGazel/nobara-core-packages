#!/bin/python3

import os
import subprocess
import sys
from pathlib import Path


PCI_DEVICES_PATH = Path("/sys/bus/pci/devices")
AMD_PCI_VENDOR_ID = 0x1002
DISPLAY_CONTROLLER_BASE_CLASS = 0x03
BASE_PACKAGES = (
    # zlib-ng-compat supplies the ABI and now pulls in Nobara's noarch "zlib"
    # package-name shim for third-party installers that query RPM names.
    "zlib-ng-compat",
    "libxcrypt-compat",
    "alsa-plugins-pulseaudio",
)


def _read_sysfs_hex(path: Path) -> int | None:
    try:
        return int(path.read_text(encoding="ascii").strip(), 0)
    except (OSError, ValueError):
        return None


def has_amd_gpu(pci_devices_path: Path = PCI_DEVICES_PATH) -> bool:
    """Return whether PCI sysfs contains an AMD display controller."""

    try:
        devices = pci_devices_path.iterdir()
        for device in devices:
            vendor_id = _read_sysfs_hex(device / "vendor")
            device_class = _read_sysfs_hex(device / "class")
            if (
                vendor_id == AMD_PCI_VENDOR_ID
                and device_class is not None
                and device_class >> 16 == DISPLAY_CONTROLLER_BASE_CLASS
            ):
                return True
    except OSError:
        pass
    return False


def required_packages(amd_gpu_present: bool) -> tuple[str, ...]:
    if amd_gpu_present:
        return ("rocm-meta", *BASE_PACKAGES)
    return BASE_PACKAGES


def main(argv: list[str] | None = None) -> int:
    args = sys.argv if argv is None else argv
    if len(args) != 2:
        print(f"Usage: {args[0]} <run_file>", file=sys.stderr)
        return 1

    run_file = str(Path(args[1]).resolve())
    amd_gpu_present = has_amd_gpu()
    if amd_gpu_present:
        print("AMD GPU detected; installing ROCm support.")
    else:
        print("No AMD GPU detected; skipping ROCm support.")

    subprocess.run(
        ["dnf", "install", "-y", *required_packages(amd_gpu_present)],
        check=True,
    )

    os.chmod(run_file, 0o775)
    subprocess.run(
        [run_file, "-u", "-y", "-a"],
        check=True,
    )
    subprocess.run(
        [run_file, "-i", "-r", "-y", "-a"],
        check=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
